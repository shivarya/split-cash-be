# Optional debug secret to protect /debug endpoints
# Set DEBUG_SECRET in your .env to a strong value and include it in the X-Debug-Secret header when calling /debug/google-verify
# DEBUG_SECRET=some-long-random-string

# --- v2 (native app) ---
# local = error details in JSON responses; anything else (or unset) = production
APP_ENV=local
# POST /auth/dev-login for local testing (also requires a request from 127.0.0.1). Never set on prod.
DEV_LOGIN_ENABLED=1
# Base URL for invite links
PUBLIC_BASE_URL=https://shivarya.dev/split_cash
# Receipt photos. On prod point this OUTSIDE public_html, e.g. /home/<user>/split_cash_uploads
# UPLOADS_DIR=
# Firebase Cloud Messaging (push). Keep the service-account JSON outside the web root.
FCM_PROJECT_ID=project-16ede906-d1b6-4716-953
# FCM_SERVICE_ACCOUNT_PATH=/path/to/split-cash-fcm.json
